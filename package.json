{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8090 --strictPort",
    "build": "vite build && vite build --ssr src/entryServer.tsx --outDir distSsr && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:dist": "vitest run tests/dist",
    "captures": "node scripts/captures.mjs"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
